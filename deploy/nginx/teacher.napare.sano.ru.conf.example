server {
    listen 443 ssl http2;
    server_name teacher.napare.sano.ru;
    ssl_certificate /etc/letsencrypt/live/napare.sano.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/napare.sano.ru/privkey.pem;
    return 301 https://napare.sano.ru/staff$request_uri;
}

server { listen 80; server_name teacher.napare.sano.ru; return 301 https://$host$request_uri; }
