{
  "name": "napare",
  "version": "1.0.0",
  "private": true,
  "description": "НаПаре — операционная система учебного дня студента",
  "scripts": {
    "dev": "turbo run dev",
    "dev:student": "turbo run dev --filter=@napare/web-student",
    "dev:portal": "turbo run dev --filter=@napare/web-portal",
    "dev:staff": "turbo run dev --filter=@napare/web-staff",
    "dev:admin": "turbo run dev --filter=@napare/web-admin",
    "dev:developer": "turbo run dev --filter=@napare/web-developer",
    "dev:max": "turbo run dev --filter=@napare/max-miniapp",
    "build": "turbo run build",
    "build:student": "turbo run build --filter=@napare/web-student",
    "build:portal": "turbo run build --filter=@napare/web-portal",
    "build:staff": "turbo run build --filter=@napare/web-staff",
    "build:admin": "turbo run build --filter=@napare/web-admin",
    "build:developer": "turbo run build --filter=@napare/web-developer",
    "build:max": "turbo run build --filter=@napare/max-miniapp",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "typecheck": "pnpm --filter @napare/backend exec tsc --noEmit && pnpm --filter @napare/web-portal exec tsc --noEmit && pnpm --filter @napare/web-student exec tsc --noEmit && pnpm --filter @napare/web-staff exec tsc --noEmit && pnpm --filter @napare/web-admin exec tsc --noEmit && pnpm --filter @napare/web-developer exec tsc --noEmit",
    "test": "turbo run test",
    "test:unit": "pnpm --filter @napare/backend exec jest --ci --runInBand",
    "test:e2e": "pnpm --filter @napare/backend exec jest --config ./test/jest-e2e.json --runInBand",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "5.9.3",
    "eslint": "^8.57.1",
    "@typescript-eslint/parser": "^7.18.0"
  },
  "packageManager": "pnpm@9.0.0"
}
