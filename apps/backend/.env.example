# App
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=napare

# JWT
JWT_SECRET=napare-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=napare-refresh-secret-change-in-production

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Sentry
SENTRY_DSN=

# CORS
CORS_ORIGIN=http://localhost:3001

# File Storage
STORAGE_ENDPOINT=localhost
STORAGE_BUCKET=napare-files
STORAGE_ACCESS_KEY=napare_minio
STORAGE_SECRET_KEY=napare_minio_secret
STORAGE_USE_SSL=false
