# Copy this file to .env on the deployment host and replace every secret.
NODE_ENV=production

# PostgreSQL
DB_NAME=napare
DB_USERNAME=napare
DB_PASSWORD=replace-with-a-long-random-database-password

# Redis
REDIS_PASSWORD=replace-with-a-long-random-redis-password

# JWT
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Public origins, comma-separated. Frontends use same-origin /api/v1 rewrites;
# keep these origins for direct API integrations and CORS-aware clients.
CORS_ORIGIN=https://napare.sano.ru,https://developer.napare.sano.ru

# Public frontend origins (baked into Next.js builds when used by the app).
NEXT_PUBLIC_STUDENT_URL=https://napare.sano.ru/student
NEXT_PUBLIC_TEACHER_URL=https://napare.sano.ru/staff
NEXT_PUBLIC_ADMIN_URL=https://napare.sano.ru/deanery
NEXT_PUBLIC_DEVELOPER_URL=https://developer.napare.sano.ru

# Optional integrations
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
